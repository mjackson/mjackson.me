{
  "name": "mjackson-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch-path=./app --watch-path=./posts --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "build": "NODE_ENV=production node --import remix/node-tsx scripts/build.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "remix": "^3.0.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
